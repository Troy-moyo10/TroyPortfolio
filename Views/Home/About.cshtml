
@{
    ViewData["Title"] = "About";
}

<section class="about-page">

    <div class="container">

        <!-- Page Title -->

        <div class="text-center mb-5">

            <h1 class="page-title">About Me</h1>

            <p class="page-subtitle">
                Learn more about who I am, my journey, and where I'm heading.
            </p>

        </div>

        <!-- About Hero -->
        <div class="row align-items-center about-top">

            <!-- LEFT -->
            <div class="col-lg-4 d-flex justify-content-start">

                <div class="about-image-card">

                    <img src="~/images/troy2.png.jpeg"
                         asp-append-version="true"
                         alt="Troy">

                </div>

            </div>

            <!-- RIGHT -->
            <!-- RIGHT -->
            <div class="col-lg-8">

                <div class="about-content">

                    <h2 class="about-heading">
                        Hi, I'm Troy Moyo👋
                    </h2>

                    <h5 class="about-role">
                        Software Developer • IT Graduate • AI Enthusiast
                    </h5>

                    <p>
                        I am an Information Technology graduate with a strong passion
                        for software development, artificial intelligence, and
                        solving real-world problems through technology.
                    </p>

                    <p>
                        I enjoy building scalable web applications using ASP.NET Core,
                        C#, SQL Server and Python.
                    </p>

                    <p>
                        I am currently focused on expanding my expertise in software
                        engineering, machine learning and cloud technologies.
                    </p>

                </div>


       </div>


    </div>
 
</div>

</section>

<!-- MY JOURNEY -->

<section class="journey-section py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">My Journey</h2>

            <p class="section-subtitle">
                From student to software developer.
            </p>

        </div>

        <div class="timeline-horizontal">

            <div class="timeline-step">

                <div class="timeline-circle"></div>

                <span class="timeline-year">2023</span>

                <div class="timeline-card">

                    <h5>Started IT Journey</h5>

                    <p>
                        Began studying Information Technology and discovered my
                        passion for software development.
                    </p>

                </div>

            </div>

            <div class="timeline-step">

                <div class="timeline-circle"></div>

                <span class="timeline-year">2024</span>

                <div class="timeline-card">

                    <h5>Expanded Skills</h5>

                    <p>
                        Learned C#, ASP.NET Core, SQL Server, Python,Data Analysis,
                        Bootstrap and JavaScript.
                    </p>

                </div>

            </div>

            <div class="timeline-step">

                <div class="timeline-circle"></div>

                <span class="timeline-year">2026</span>

                <div class="timeline-card">

                    <h5>Software Developer Intern</h5>

                    <p>
                        Started building enterprise software and real-world
                        applications.
                    </p>

                </div>

            </div>

            <div class="timeline-step">

                <div class="timeline-circle"></div>

                <span class="timeline-year">Future</span>

                <div class="timeline-card">

                    <h5>Software Engineer</h5>

                    <p>
                        Building AI-powered systems and cloud applications that
                        solve real problems.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- VALUES -->

<section class="values-section py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">What Drives Me</h2>

            <p class="section-subtitle">
                The values that shape the way I work.
            </p>

        </div>

        <div class="row g-4">

            <!-- Card 1 -->

            <div class="col-lg-4">

                <div class="value-card">

                    <i class="bi bi-lightbulb"></i>

                    <h4>Innovation</h4>

                    <p>
                        I enjoy finding creative solutions to complex
                        challenges and building technology that makes
                        a real impact.
                    </p>

                </div>

            </div>

            <!-- Card 2 -->

            <div class="col-lg-4">

                <div class="value-card">

                    <i class="bi bi-code-slash"></i>

                    <h4>Clean Code</h4>

                    <p>
                        Writing maintainable, scalable and efficient
                        software is at the core of everything I build.
                    </p>

                </div>

            </div>

            <!-- Card 3 -->

            <div class="col-lg-4">

                <div class="value-card">

                    <i class="bi bi-graph-up-arrow"></i>

                    <h4>Continuous Growth</h4>

                    <p>
                        Every project is an opportunity to learn,
                        improve and become a better developer.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>