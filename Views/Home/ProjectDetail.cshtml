        {
            <div class="text-center py-5">
                <h2>Project Not Found</h2>
                <p class="mt-3 text-muted">The requested project detail page does not exist.</p>
                <a asp-controller="Home" asp-action="Projects" class="btn btn-primary-solid mt-3">
                    Back to Projects
                </a>
            </div>
