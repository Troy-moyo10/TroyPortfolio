                            <h5>Category</h5>
                            <p>Agritech Marketplace</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (projectId == "portfolio-website")
        {
            <div class="project-detail-header mb-5">
                <span class="project-status completed mb-3 d-inline-block">✔ Completed</span>
                <h1 class="project-detail-title">Troy Portfolio</h1>
                <div class="tech-stack mt-3">
