@{
    var projectId = ViewBag.ProjectId as string ?? "";
    string title = projectId switch
    {
        "vision-guard" => "Vision Guard",
        "dailyopstrack" => "DailyOpsTrack",
        "paicta-artisanconnect" => "PAICTA ArtisanConnect",
        "thrive-development-group" => "Thrive Development Group",
        "imifuno" => "Imifuno",
        "portfolio-website" => "Troy Portfolio",
        "hospital-management-system" => "Hospital Management System",
        _ => "Project Details"
    };
    ViewData["Title"] = title;
}

<section class="projects-page py-5">
    <div class="container">

        <!-- Back link -->
        <div class="mb-4">
            <a asp-controller="Home" asp-action="Projects" class="btn-back">
                <i data-lucide="arrow-left" class="lucide-icon-sm"></i> Back to Projects
            </a>
        </div>

        @if (projectId == "vision-guard")
        {
            <div class="project-detail-header mb-5">
                <span class="project-status mb-3 d-inline-block">● In Progress</span>
                <h1 class="project-detail-title">Vision Guard</h1>
                <div class="tech-stack mt-3">
                    <span>Django</span>
                    <span>Android Java</span>
                    <span>DJI Mobile SDK</span>
                    <span>RTMP</span>
                    <span>HLS</span>
                    <span>MediaMTX</span>
                    <span>Firebase</span>
                </div>
            </div>

            <div class="row g-5">
                <div class="col-lg-8">
                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="info" class="lucide-icon-sm"></i> Project Overview</h2>
                        <p>
                            Vision Guard is an autonomous drone surveillance and incident management platform designed to support security operations. It enables live video streaming, automated patrol coordination, and telemetry tracking from field drones directly into an operations dashboard.
                        </p>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="alert-circle" class="lucide-icon-sm"></i> Problem Addressed</h2>
                        <p>
                            Traditional ground patrols face blind spots, delayed emergency response times, and limited visibility in large facilities or perimeter perimeters. Vision Guard addresses this by providing aerial monitoring and low-latency video feeds to decision-makers.
                        </p>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="cpu" class="lucide-icon-sm"></i> How the System Works</h2>
                        <p>
                            An Android application built with the DJI Mobile SDK interfaces with the drone hardware, pulling live video and flight telemetry. The stream is pushed via RTMP to a MediaMTX media server, transcoded to HLS, and broadcast to an operator dashboard built on Django. Firebase and REST services coordinate real-time mission commands and event alerts.
                        </p>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="check-circle" class="lucide-icon-sm"></i> Main Features</h2>
                        <ul class="detail-list">
                            <li>Live drone video streaming via RTMP/HLS pipeline</li>
                            <li>Real-time telemetry display (altitude, battery, GPS coordinates)</li>
                            <li>Incident logging, tagging, and geo-location mapping</li>
                            <li>Android ground control app utilizing DJI Mobile SDK</li>
                            <li>Operator command dashboard with incident timeline</li>
                        </ul>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="user" class="lucide-icon-sm"></i> My Contribution</h2>
                        <p>
                            Designed and developed the video streaming architecture using MediaMTX, created the Android control application with DJI SDK, and built the Django management interface and REST endpoints.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="detail-sidebar">
                        <div class="detail-meta-card">
                            <h5>Project Status</h5>
                            <span class="project-status">● In Progress</span>
                        </div>
                        <div class="detail-meta-card">
                            <h5>Technologies</h5>
                            <div class="technology-tags mt-2">
                                <span class="technology-tag">Django</span>
                                <span class="technology-tag">Android</span>
                                <span class="technology-tag">Java</span>
                                <span class="technology-tag">DJI SDK</span>
                                <span class="technology-tag">MediaMTX</span>
                                <span class="technology-tag">RTMP/HLS</span>
                            </div>
                        </div>
                        <div class="detail-meta-card">
                            <h5>Category</h5>
                            <p>Drone Systems &amp; Web Platform</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (projectId == "dailyopstrack")
        {
            <div class="project-detail-header mb-5">
                <span class="project-status completed mb-3 d-inline-block">✔ Completed</span>
                <h1 class="project-detail-title">DailyOpsTrack</h1>
                <div class="tech-stack mt-3">
                    <span>ASP.NET Core</span>
                    <span>C#</span>
                    <span>SQL Server</span>
                    <span>Entity Framework</span>
                    <span>Bootstrap</span>
                </div>
            </div>

            <div class="row g-5">
                <div class="col-lg-8">
                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="info" class="lucide-icon-sm"></i> Project Overview</h2>
                        <p>
                            DailyOpsTrack is an internal operational tracking application designed for businesses to log daily tasks, monitor project milestones, and generate summary reports for leadership and management.
                        </p>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="alert-circle" class="lucide-icon-sm"></i> Problem Addressed</h2>
                        <p>
                            Teams frequently struggle with fragmented progress updates across chat channels and disparate spreadsheets, creating blind spots in daily accountability and deliverables tracking.
                        </p>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="cpu" class="lucide-icon-sm"></i> How the System Works</h2>
                        <p>
                            The system is structured as an ASP.NET Core MVC application backed by SQL Server. Users authenticate, record task logs, update ticket progress, and attach milestone records. Reports are generated dynamically using relational aggregation queries.
                        </p>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="check-circle" class="lucide-icon-sm"></i> Main Features</h2>
                        <ul class="detail-list">
                            <li>Role-based task management and milestone creation</li>
                            <li>Daily operational activity logging and audits</li>
                            <li>Weekly report aggregation and filtering</li>
                            <li>Responsive, clean dashboard for desktop and mobile</li>
                        </ul>
                    </div>

                    <div class="detail-section">
                        <h2 class="detail-section-title"><i data-lucide="user" class="lucide-icon-sm"></i> My Contribution</h2>
                        <p>
                            Implemented the database schema, developed core MVC controllers, built data access with Entity Framework Core, and styled the user interface with clean Bootstrap components.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="detail-sidebar">
                        <div class="detail-meta-card">
                            <h5>Project Status</h5>
                            <span class="project-status completed">✔ Completed</span>
                        </div>
                        <div class="detail-meta-card">
                            <h5>Technologies</h5>
                            <div class="technology-tags mt-2">
                                <span class="technology-tag">ASP.NET Core</span>
                                <span class="technology-tag">C#</span>
                                <span class="technology-tag">SQL Server</span>
                                <span class="technology-tag">Entity Framework</span>
                                <span class="technology-tag">Bootstrap</span>
                            </div>
                        </div>
                        <div class="detail-meta-card">
                            <h5>Category</h5>
                            <p>Enterprise Operations Tool</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (projectId == "paicta-artisanconnect")
        {
            <div class="project-detail-header mb-5">
                <span class="project-status completed mb-3 d-inline-block">✔ Completed</span>
                <h1 class="project-detail-title">PAICTA ArtisanConnect</h1>
                <div class="tech-stack mt-3">
                    <span>ASP.NET Core MVC</span>
                    <span>C#</span>
                    <span>SQL Server</span>
                    <span>Bootstrap</span>
                    <span>JavaScript</span>
