@{
    ViewData["Title"] = "Projects";
}

<section class="projects-page py-5">

    <div class="container">

        <!-- Heading -->

        <div class="text-center mb-5">

            <h1 class="page-title">My Projects</h1>

            <p class="page-subtitle">
                A collection of applications that showcase my software development journey.
            </p>

        </div>

        <!-- Featured -->

        <h2 class="section-title mb-4">
            ⭐ Featured Project
        </h2>

        <div class="featured-project">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <span class="project-status">
                        ● Currently Developing
                    </span>

                    <h2>
                        Security Intelligence System
                    </h2>

                    <p>

                        An intelligent security platform designed to help security
                        companies prevent crime before it happens through live
                        incident management, predictive analytics, GPS tracking,
                        drone deployment and AI-assisted decision making.

                    </p>

                    <div class="tech-stack">

                        <span>ASP.NET Core</span>
                        <span>C#</span>
                        <span>SQL Server</span>
                        <span>Python</span>
                        <span>Machine Learning</span>
                        <span>REST API</span>

                    </div>

                </div>

                <div class="col-lg-4 text-center">

                    <i class="bi bi-shield-lock project-icon"></i>

                </div>

            </div>

        </div>

        <!-- Other Projects -->

        <h2 class="section-title mt-5 mb-4">
            Other Projects
        </h2>

        <div class="row g-4">

            <!-- Portfolio -->

            <div class="col-lg-6">

                <div class="project-card">

                    <span class="project-status completed">

                        ✔ Completed

                    </span>

                    <h3>Portfolio Website</h3>

                    <p>

                        Designed and developed a responsive ASP.NET Core MVC
                        portfolio website showcasing my skills, projects and
                        experience using modern UI principles.

                    </p>

                    <div class="tech-stack">

                        <span>ASP.NET MVC</span>
                        <span>Bootstrap</span>
                        <span>HTML</span>
                        <span>CSS</span>
                        <span>JavaScript</span>

                    </div>

                </div>

            </div>

            <!-- Coming Soon -->

            <div class="col-lg-6">

                <div class="project-card future-card">

                    <i class="bi bi-rocket-takeoff display-4"></i>

                    <h3>More Projects Coming</h3>

                    <p>

                        I'm continuously building software while expanding
                        my expertise in AI, cloud computing and enterprise
                        application development.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>