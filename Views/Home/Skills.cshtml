@{
    ViewData["Title"] = "Skills";
}

<section class="page-section">
    <div class="container">

        <!-- Page Heading -->
        <div class="page-heading-sm text-center">
            <span class="section-label">Technical Skills</span>
            <h1 class="skills-page-title mt-2">Tools and technologies</h1>
            <p class="skills-page-subtitle">
                Technologies and skills across software engineering, web development, systems, and tools.
            </p>
        </div>

        <!-- Skills Grid: Individual Cards in a Responsive Grid -->
        <div class="skills-grid">

            <!-- 1. Programming Languages -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="code-2" class="lucide-icon"></i>
                </div>
                <h3>Programming Languages</h3>
                <p>Core languages used for application development, system scripting, and algorithmic problem solving.</p>
                <div class="technology-tags">
                    <span class="technology-tag">C#</span>
                    <span class="technology-tag">Java</span>
                    <span class="technology-tag">Python</span>
                    <span class="technology-tag">JavaScript</span>
                    <span class="technology-tag">TypeScript</span>
                    <span class="technology-tag">PHP</span>
                </div>
            </div>

            <!-- 2. Frontend Development -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="layout" class="lucide-icon"></i>
                </div>
                <h3>Frontend Development</h3>
                <p>Designing and building accessible, modern, responsive client interfaces with structured UI frameworks.</p>
                <div class="technology-tags">
                    <span class="technology-tag">HTML</span>
                    <span class="technology-tag">CSS</span>
                    <span class="technology-tag">Bootstrap</span>
                    <span class="technology-tag">React</span>
                    <span class="technology-tag">Razor Views</span>
                </div>
            </div>

            <!-- 3. Backend Development -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="server" class="lucide-icon"></i>
                </div>
                <h3>Backend Development</h3>
                <p>Developing robust server-side architectures, RESTful APIs, and secure business logic services.</p>
                <div class="technology-tags">
                    <span class="technology-tag">ASP.NET Core MVC</span>
                    <span class="technology-tag">Django</span>
                    <span class="technology-tag">Django REST Framework</span>
                    <span class="technology-tag">Flask</span>
                    <span class="technology-tag">Node.js</span>
                </div>
            </div>

            <!-- 4. Databases -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="database" class="lucide-icon"></i>
                </div>
                <h3>Databases</h3>
                <p>Designing relational schemas, optimizing queries, and managing local and cloud persistence stores.</p>
                <div class="technology-tags">
                    <span class="technology-tag">SQL</span>
                    <span class="technology-tag">Firebase</span>
                    <span class="technology-tag">LocalDB</span>
                </div>
            </div>

            <!-- 5. Cloud and Integrations -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="cloud" class="lucide-icon"></i>
                </div>
                <h3>Cloud and Integrations</h3>
                <p>Integrating streaming protocols, hardware SDKs, cloud backends, and third-party external services.</p>
                <div class="technology-tags">
                    <span class="technology-tag">Firebase</span>
                    <span class="technology-tag">REST APIs</span>
                    <span class="technology-tag">DJI Mobile SDK</span>
                    <span class="technology-tag">RTMP</span>
                    <span class="technology-tag">HLS</span>
                    <span class="technology-tag">MediaMTX</span>
                </div>
            </div>

            <!-- 6. Mobile Development -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="smartphone" class="lucide-icon"></i>
                </div>
                <h3>Mobile Development</h3>
                <p>Building mobile applications and native drone/hardware control integrations on Android.</p>
                <div class="technology-tags">
                    <span class="technology-tag">Android</span>
                    <span class="technology-tag">Java</span>
                    <span class="technology-tag">DJI Mobile SDK</span>
                </div>
            </div>

            <!-- 7. Development Tools -->
            <div class="skill-card">
                <div class="skill-icon">
                    <i data-lucide="terminal" class="lucide-icon"></i>
                </div>
                <h3>Development Tools</h3>
                <p>Work environment, version control tooling, and developer IDEs used for testing and deployment.</p>
                <div class="technology-tags">
                    <span class="technology-tag">Git</span>
                    <span class="technology-tag">GitHub</span>
                    <span class="technology-tag">Visual Studio</span>
                    <span class="technology-tag">VS Code</span>
                    <span class="technology-tag">Android Studio</span>
                </div>
            </div>

        </div>

    </div>
</section>

@section Scripts {
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
}