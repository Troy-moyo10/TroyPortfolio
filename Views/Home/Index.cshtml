@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <!-- LEFT -->
            <div class="col-lg-7">

                <p class="hero-intro">
                    Hello, I'm
                </p>

                <h1 class="hero-title">
                    Troy Moyo
                </h1>

                <h2 class="hero-subtitle">
                    Software Developer<br>
                    <span class="hero-subtitle-detail">Information Technology Graduate</span>
                </h2>

                <p class="hero-description">
                    I build web applications, REST APIs, and data-driven systems
                    using ASP.NET Core, C#, Python and SQL Server. Currently
                    working on enterprise software and exploring cloud
                    technologies and machine learning.
                </p>

                <div class="hero-buttons">
                    <a href="~/Files/Troy_Moyo_Updated_CV.pdf"
                       download
                       class="btn btn-primary-solid">
                        Download CV
                    </a>
                    <a href="~/Files/Troy_Moyo_Updated_CV.pdf"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline">
                        Preview CV
                    </a>
                    <a asp-controller="Home"
                       asp-action="Projects"
                       class="btn btn-outline">
                        View Projects
                    </a>
                </div>

                <div class="hero-tech">
                    <span>C#</span>
                    <span>ASP.NET Core</span>
                    <span>Python</span>
                    <span>SQL Server</span>
                    <span>Java</span>
                    <span>JavaScript</span>
                </div>

                <div class="hero-divider"></div>

                <div class="hero-stats">
                    <div class="stat-card">
                        <h3 class="count-up" data-count="7">7</h3>
                        <p>Projects</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="count-up" data-count="15">15</h3>
                        <p>Technologies</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="count-up" data-count="2026">2026</h3>
                        <p>Graduate</p>
                    </div>
                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-5 d-flex justify-content-center">
                <div class="profile-card">
                    <img src="~/images/troy.png.jpeg" asp-append-version="true" alt="Troy Moyo" />
                    <div class="profile-info">
                        <h4>Troy Moyo</h4>
                        <p>Software Developer</p>
                        <small><i data-lucide="map-pin" class="lucide-icon-sm" aria-hidden="true"></i>East London, South Africa</small>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
