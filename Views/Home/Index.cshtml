@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <!-- LEFT -->
            <div class="col-lg-7">

                <p class="hero-intro">
                    <i class="bi bi-hand-wave"></i> Hello, I'm
                </p>

                <h1 class="hero-title">
                    Troy Moyo
                </h1>

                <h2 class="hero-subtitle">
                    Software Developer<br>
                    <span style="font-size:.85em; color:var(--clr-text-muted);">Information Technology Graduate</span>
                </h2>

                <p class="hero-description">
                    I build web applications, REST APIs, and data-driven systems
                    using ASP.NET Core, C#, Python and SQL Server. Currently
                    working on enterprise software and exploring cloud
                    technologies and machine learning.
                </p>

                <div class="hero-buttons">
                    <a href="~/Files/Troy_Moyo_CV.pdf"
                       download
                       class="btn btn-primary-solid">
                        <i class="bi bi-download"></i>
                        Download CV
                    </a>
                    <a asp-controller="Home"
                       asp-action="Projects"
                       class="btn btn-outline">
                        View Projects
                    </a>
                </div>

                <div class="hero-tech">
                    <span>C#</span>
                    <span>ASP.NET Core</span>
                    <span>Python</span>
                    <span>SQL Server</span>
                    <span>Java</span>
                    <span>JavaScript</span>
                </div>

                <div class="hero-divider"></div>

                <div class="hero-stats">
                    <div class="stat-card">
                        <i class="bi bi-folder2-open"></i>
                        <h3>7+</h3>
                        <p>Projects</p>
                    </div>
                    <div class="stat-card">
                        <i class="bi bi-code-slash"></i>
                        <h3>15+</h3>
                        <p>Technologies</p>
                    </div>
                    <div class="stat-card">
                        <i class="bi bi-mortarboard"></i>
                        <h3>2026</h3>
                        <p>Graduate</p>
                    </div>
                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-5 d-flex justify-content-center">
                <div class="profile-card">
                    <img src="~/images/troy.png.jpeg" asp-append-version="true" alt="Troy Moyo" />
                    <div class="profile-info">
                        <h4>Troy Moyo</h4>
                        <p>Software Developer</p>
                        <small><i class="bi bi-geo-alt me-1"></i>East London, South Africa</small>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>