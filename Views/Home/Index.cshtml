@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center gy-5">

            <!-- LEFT SIDE -->

            <div class="col-lg-7">

                <p class="hero-intro">
                    👋 Hello, I'm
                </p>

                <h1 class="hero-title">
                    Troy Moyo
                </h1>

                <h2 class="hero-subtitle">
                    Software Developer
                    <br />
                    Information Technology Graduate
                </h2>

                <p class="hero-description">

                    Passionate about building modern software,
                    intelligent systems, and scalable web applications
                    using ASP.NET Core, C#, Python and SQL Server.

                </p>

                <div class="hero-buttons">

                    <a href="~/Files/Troy_Moyo_CV.pdf"
                       download
                       class="btn btn-outline-primary">

                        <i class="bi bi-download me-2"></i>
                        Download CV

                    </a>
                    <a asp-controller="Home"
                       asp-action="Projects"
                       class="btn btn-outline-primary hero-btn-secondary">

                        View Projects

                    </a>

                </div>

                <div class="hero-tech">

                    <span>C#</span>

                    <span>ASP.NET Core</span>

                    <span>Python</span>

                    <span>SQL Server</span>

                    <span>Machine Learning</span>

                </div>

                <div class="hero-divider"></div>

               <div class="hero-stats">

                    <div class="hero-stats">

                        <div class="stat-card">
                            <i class="bi bi-folder2-open"></i>
                            <h3>5+</h3>
                            <p>Projects</p>
                        </div>

                        <div class="stat-card">
                            <i class="bi bi-code-slash"></i>
                            <h3>10+</h3>
                            <p>Technologies</p>
                        </div>

                        <div class="stat-card">
                            <i class="bi bi-mortarboard"></i>
                            <h3>2026</h3>
                            <p>Graduate</p>
                        </div>

                    </div>
                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div div class="col-lg-5 d-flex justify-content-center">

                <div class="profile-card">

                    <img src="~/images/troy.png.jpeg" asp-append-version="true" alt="Troy" />

                    <div class="profile-info">

                        <h4>Troy</h4>

                        <p>Software Developer</p>

                        <small>East London, South Africa</small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>