@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-section">
    <div class="container error-state">
        <h1 class="page-title">Something went wrong</h1>
        <p class="page-subtitle">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="error-request-id">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <aside class="error-development-note">
            <h2>Development Mode</h2>
            <p>
                The Development environment can show more detailed error information. Do not enable it on a deployed application because it may expose sensitive details.
            </p>
            <p>
                For local debugging, set <code>ASPNETCORE_ENVIRONMENT</code> to <code>Development</code> and restart the app.
            </p>
        </aside>
    </div>
</section>
