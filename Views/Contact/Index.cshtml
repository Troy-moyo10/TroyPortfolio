@model TroyPortfolio.Models.ContactFormModel

@{
    ViewData["Title"] = "Contact";
}

<section class="contact-page">

    <div class="container">

        <div class="text-center mb-5">

            <h1 class="page-title">Get In Touch</h1>

            <p class="page-subtitle">
                Have a project, internship opportunity?
                I'd love to hear from you.
            </p>

        </div>

        <div class="row g-5">

            <!-- LEFT -->

            <div class="col-lg-4">

                <h2 class="mb-4">Let's Connect</h2>

                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <div>
                        <h5>Email</h5>
                        <p>troymoyo5@gmail.com</p>
                    </div>
                    

                </div>

                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <div>
                        <h5>Location</h5>
                        <p>East London, South Africa</p>
                    </div>

                </div>

                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>

                    <div>
                        <h5>Availability</h5>
                        <p>Open for Internship Opportunities</p>
                    </div>

                </div>

                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>

                    <div>
                        <h5>Response Time</h5>
                        <p>Usually within 24 Hours</p>
                    </div>

                </div>

            </div>
           

            <!-- RIGHT -->

            <div class="col-lg-8">

                <div class="contact-form">

                    @if (TempData["Success"] != null)
                    {
                        <div class="contact-success">

                            <i class="bi bi-check-circle-fill"></i>

                            <div>

                                <strong>Message Sent!</strong>

                                <p>Thank you for reaching out. I'll get back to you as soon as possible.</p>

                            </div>

                        </div>
                    }
                    <form asp-action="Index" method="post" class="contact-form">

                        <div class="mb-4">

                            <label class="form-label">Full Name</label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Your Name" />

                        </div>

                        <div class="mb-4">

                            <label class="form-label">Email Address</label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Email" />

                        </div>

                        <div class="mb-4">

                            <label asp-for="Subject" class="form-label"></label>

                            <select asp-for="Subject" class="form-select">

                                <option value="">-- Select a Subject --</option>

                                <option>Internship Opportunity</option>

                                <option>Job Opportunity</option>

                                <option>Project Collaboration</option>

                                <option>Freelance Work</option>

                               <option>Portfolio Feedback</option>

                                <option>Other</option>

                            </select>

                            <span asp-validation-for="Subject" class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">Message</label>

                            <textarea asp-for="Message"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Tell me about your project or opportunity..."></textarea>

                        </div>

                        <button type="submit" class="btn contact-btn w-100">

                            <i class="bi bi-send-fill me-2"></i>

                            Send Message

                        </button>

                        <p class="contact-note mt-3">

                            <i class="bi bi-shield-check me-2"></i>

                            Your information is kept private and will only be used to respond to your message.

                        </p>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}